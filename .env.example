# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB
MONGO_URI=

# Auth — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (image hosting) — leave blank to disable uploads until configured
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe — leave blank to disable checkout/payments until configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (Nodemailer) — leave blank to log emails to the console instead of sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="VELORA <no-reply@velora.com>"

# Seed / demo admin account (used only by `npm run seed`, never hardcoded)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Client (Vite — must be prefixed VITE_) ──────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=
