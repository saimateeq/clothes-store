# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# MongoDB
MONGO_URI=

# Auth — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (image hosting) — leave blank to disable uploads until configured
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe — leave blank to disable checkout/payments until configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email, https://resend.com) — leave blank to log
# emails to the console instead of sending. EMAIL_FROM defaults to Resend's
# shared sandbox address (only deliverable to your own Resend account email)
# until you verify a sending domain in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM="VELORA <onboarding@resend.dev>"

# Seed / demo admin account (used only by `npm run seed`, never hardcoded)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OpenAI (AI Stylist, Shopping Assistant, and other AI features) — server-side
# only, never exposed to the client. Leave OPENAI_API_KEY blank to disable AI
# features until configured; they return a friendly 503 instead of erroring.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Client (Vite — must be prefixed VITE_) ──────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_STRIPE_PUBLISHABLE_KEY=
