{
  "name": "velora",
  "private": true,
  "version": "0.0.0",
  "description": "VELORA — premium MERN fashion e-commerce platform",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev --prefix server\" \"npm:dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "build": "vite build",
    "start": "node server.js",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
